# 运行时生成的数据库与缓存
file_index.db
*.db
__pycache__/
*.pyc
.venv/
venv/

# PyInstaller 打包产物
build/
dist/

# SQLite WAL/SHM 残留
*.db-*

# 本地运行配置与单实例锁（用户设置，不随仓库分发）
# 注意：config.json 若已被跟踪，需执行 `git rm --cached config.json` 才会真正脱库
config.json
instance.lock

# 运行日志（logs/ 与 DB 同目录生成，打包版亦同）
logs/
*.log

# 测试截图与 HTML 分享包（过程产物，可重新生成）
.screenshots/
.trae-html-share-packages/

# 操作系统/编辑器临时文件
.DS_Store
Thumbs.db
*.swp
.idea/
